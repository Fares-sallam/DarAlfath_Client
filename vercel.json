{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "suf": ".vercel.app"
          }
        }
      ],
      "missing": [
        {
          "type": "host",
          "value": {
            "eq": "dar-alfath-client.vercel.app"
          }
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/book/:id",
      "destination": "/api/page?kind=book&id=:id"
    },
    {
      "source": "/books",
      "destination": "/api/page?kind=books"
    },
    {
      "source": "/categories",
      "destination": "/api/page?kind=categories"
    },
    {
      "source": "/contact",
      "destination": "/api/page?kind=contact"
    },
    {
      "source": "/policies",
      "destination": "/api/page?kind=policies"
    },
    {
      "source": "/links",
      "destination": "/api/page?kind=links"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
