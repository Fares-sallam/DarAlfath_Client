VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_AUTH_REDIRECT_ORIGIN=http://127.0.0.1:5173

# Optional Cloudflare Turnstile site key for storefront checkout protection.
# Leave empty to keep checkout working without captcha.
VITE_TURNSTILE_SITE_KEY=

# Edge Function secrets are configured in Supabase, not in Vite:
# INTERNAL_FUNCTION_SECRET=...
# REQUIRE_TURNSTILE=false
# TURNSTILE_SECRET_KEY=...
